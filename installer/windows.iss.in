; Версия и пути подставляются CMake. Пользовательские данные в пакет не входят.
[Setup]
AppId={{3640C802-CA1A-4194-AF18-D3C449E082CA}
AppName=OldMoneyTatarin
AppPublisher=TATARIN
VersionInfoCompany=TATARIN Co.
AppVersion=@OldMoneyTatarin_VERSION@
VersionInfoVersion=@OldMoneyTatarin_VERSION@.0
DefaultDirName={localappdata}\Programs\OldMoneyTatarin
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=@INSTALLER_OUTPUT@
OutputBaseFilename=OldMoneyTatarin-@OldMoneyTatarin_VERSION@-Setup-x64
SetupIconFile=@CMAKE_SOURCE_DIR@/program_info/@Launcher_APP_BINARY_NAME@.ico
UninstallDisplayIcon={app}\@Launcher_APP_BINARY_NAME@.exe
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
DisableWelcomePage=yes
DisableDirPage=no
DisableProgramGroupPage=yes
DisableReadyPage=yes
DisableFinishedPage=no
ShowLanguageDialog=no
AllowNoIcons=yes
CloseApplications=no
RestartApplications=no
SetupLogging=yes

[Languages]
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Files]
Source: "@INSTALLER_STAGE@\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{userprograms}\OldMoneyTatarin"; Filename: "{app}\@Launcher_APP_BINARY_NAME@.exe"; WorkingDir: "{app}"

[Run]
Filename: "{app}\@Launcher_APP_BINARY_NAME@.exe"; WorkingDir: "{app}"; Description: "Открыть лаунчер"; Flags: nowait postinstall skipifsilent

[Code]
procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpSelectDir then
    WizardForm.NextButton.Caption := SetupMessage(msgButtonInstall);
end;
